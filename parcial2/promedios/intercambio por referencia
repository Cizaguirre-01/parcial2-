#include <iostream>
using namespace std;

void intercambie (int&a, int&b){
    int temporal= a;
    a = b;
    b = temporal;

}

int main(){
    int a= 1;
    int b= 2;
    
    cout<<" ahora: a= "<< a << ",b="<< b << endl;
    cout<<'\n';
    intercambie(a,b);
    
    cout<<" ya intercambiados a="<< a <<",b="<< b << endl;
    
    return 0;


}
