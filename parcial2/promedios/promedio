#include <iostream>
using namespace std;

int main() {
    float calificaciones[6]= {0};
    
    float acumulador = 0;
    

    
    for (int i = 0; i < 5; i++){
        cout << "Ingrese la calificación " << i + 1 << ": ";
        cin >> calificaciones[i];
        acumulador+= calificaciones[i];
    }
    calificaciones[5] = acumulador / 5;
    cout << "El promedio de las calificaciones es: " << calificaciones[5] << endl;
    cout << "Las calificaciones ingresadas son: \n " << endl;
    for (int i = 0; i < 5; i++){
        cout << "calificaciones" <<i+1<< ": " << calificaciones[i] << endl;
    }
    
    return 0;
}   

