#include <iostream>
using namespace std;

void intercambiePuntero (int*a, int*b){
    int temporal= *a;
    *a = *b;
    *b = temporal;
    

}

int main(){
    int a= 5;
    int b= 6;
    
    int*ptra= &a;
    int*ptrb= &b;
    
    cout<<" antes de intercambiar: a= "<< a << ",b="<< b << endl;
    cout<<'\n';
    intercambiePuntero (ptra,ptrb);
    
    cout<<" ya intercambiados a="<< a <<",b="<< b << endl;
    
    return 0;


}

