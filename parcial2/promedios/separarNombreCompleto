#include<iostream>
#include<string>
#include<ctype.h>
using namespace std;

bool tieneunNumero(string nombre){
    for(int i=0;i<nombre.size();i++){
        if(isdigit(nombre[i])){
            return true;
        }
    }
    return false;
}
int main(){
 string nombre;
 cout<< "Ingrese su nombre completo: ";

 getline(cin, nombre);
 int espacios=nombre.find(" ");
 
 string primerNombre=nombre.substr(0,espacios);
 cout<< "Su primer nombre es: "<<primerNombre<<endl;
 string apellido=nombre.substr(espacios+1);
 cout<< "Su apellido es: "<<apellido<<endl;

  if(tieneunNumero(primerNombre)&&tieneunNumero(apellido)){
        cout<< "Su nombre y apellido contienen numeros"<<endl;
    }else if(tieneunNumero(primerNombre)){
        cout<< "Su nombre contiene  numeros"<<endl;
    }else if(tieneunNumero(apellido)){
        cout<< "Su apellido contiene  numeros"<<endl;
    }else{
        cout<< "Su nombre y apellido no contienen numeros"<<endl;
    }
    return 0;
}
