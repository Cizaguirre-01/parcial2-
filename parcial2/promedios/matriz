#include <iostream>
using namespace std;

int main(){
    double matriz [10][3];

    for (int i=0; i<10; i++){
        cout<< "Digite los numero del grupo A ["<<i<<"]["<<0<<"]: ";
        cin>>matriz[i][0];
    }

    for (int i=0; i<10; i++){
        cout<< "Digite  los numero del grupo B ["<<i<<"]["<<1<<"]: ";
        cin>>matriz[i][1];
    }


    for (int i=0; i<10; i ++){
        if (matriz[i][0] < matriz[i][1]) {
            matriz[i][2] = matriz[i][1];
            cout<< " El promedio mas alto es del grupo B del alumno " << i + 1 << " es: " << matriz[i][2] << endl;
        } else {
            matriz[i][2] = matriz[i][0];
            cout<< " El promedio mas alto es del grupo A del alumno " << i + 1 << " es: " << matriz[i][2] << endl;
        }
    }

    return 0;
}
