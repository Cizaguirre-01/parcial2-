#include <iostream>
using namespace std;

int main(){
    double matriz [10][3];
    

    for (int i=0; i<10; i++){
        cout<< "Digite los numero del grupo A alumno " << i + 1 << " ["<<i<<"]["<<0<<"]: ";
        cin>>matriz[i][0];
    }
    cout<< "\n";


    for (int i=0; i<10; i++){
        cout<< "Digite  los numero del grupo B alumno " << i + 1 << " ["<<i<<"]["<<1<<"]: ";
        cin>>matriz[i][1];
    }
    cout<< "\n";


    for (int i=0; i<10; i ++){
        if (matriz[i][0] < matriz[i][1]) {
            matriz[i][2] = matriz[i][1];
            cout<< " El promedio mas alto es del grupo B del alumno " << i + 1 << " es: " << matriz[i][2] << endl;
        } else {
            matriz[i][2] = matriz[i][0];
            cout<< " El promedio mas alto es del grupo A del alumno " << i + 1 << " es: " << matriz[i][2] << endl;
        }
    }
    cout<< "\n";

    cout<< " En formato matriz  \n";
    cout<< " Grupo A  Grupo B  Promedio mas alto \n";
    for (int i=0; i<10; i++){
        for (int j=0; j<3; j++){
            cout<< matriz[i][j] << " \t ";
        }
        cout<< "\n";
    }


    return 0;
}
